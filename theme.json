{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 2,
	"title": "Köhlbrand",
	"templateParts": [
		{ "name": "header", "area": "header", "title": "Kopfbereich" },
		{ "name": "footer", "area": "footer", "title": "Fußbereich" },
		{ "name": "sidebar", "area": "uncategorized", "title": "Sidebar (Artikel & Archiv)" }
	],
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "ink", "name": "Dusk-Navy (Ink)", "color": "#12242F" },
				{ "slug": "primary", "name": "Dusk-Blau", "color": "#1C3A52" },
				{ "slug": "steel", "name": "Stahlblau", "color": "#526A7A" },
				{ "slug": "accent", "name": "Sonnenuntergangs-Amber", "color": "#E39A3B" },
				{ "slug": "fog", "name": "Nebelgrau-Blau", "color": "#C7D2D6" },
				{ "slug": "sand", "name": "Warmes Off-White", "color": "#F6F2EA" },
				{ "slug": "bg-alt", "name": "Sandbeige", "color": "#ECE6DA" },
				{ "slug": "white", "name": "Weiß", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"customFontSize": false,
			"fontFamilies": [
				{
					"slug": "headline",
					"name": "Barlow Semi Condensed (Headlines)",
					"fontFamily": "'Barlow Semi Condensed', 'Barlow', system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Barlow Semi Condensed",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/barlow-semi-condensed-500.woff2" ]
						},
						{
							"fontFamily": "Barlow Semi Condensed",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/barlow-semi-condensed-600.woff2" ]
						},
						{
							"fontFamily": "Barlow Semi Condensed",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/barlow-semi-condensed-700.woff2" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "IBM Plex Sans (Fließtext)",
					"fontFamily": "'IBM Plex Sans', system-ui, -apple-system, sans-serif",
					"fontFace": [
						{
							"fontFamily": "IBM Plex Sans",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans-400.woff2" ]
						},
						{
							"fontFamily": "IBM Plex Sans",
							"fontWeight": "400",
							"fontStyle": "italic",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans-400-italic.woff2" ]
						},
						{
							"fontFamily": "IBM Plex Sans",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans-500.woff2" ]
						},
						{
							"fontFamily": "IBM Plex Sans",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans-600.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Klein (Meta)", "size": "0.875rem" },
				{ "slug": "medium", "name": "Basis (Fließtext)", "size": "1rem" },
				{ "slug": "large", "name": "Groß (H3)", "size": "1.5rem" },
				{ "slug": "x-large", "name": "XL (H2)", "size": "2.125rem" },
				{ "slug": "xx-large", "name": "XXL (H1)", "size": "clamp(2.25rem, 1.55rem + 2.9vw, 3.125rem)" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"customSpacingSize": false,
			"spacingSizes": [
				{ "slug": "xs", "name": "XS", "size": "0.5rem" },
				{ "slug": "sm", "name": "SM", "size": "1rem" },
				{ "slug": "md", "name": "MD", "size": "1.5rem" },
				{ "slug": "lg", "name": "LG", "size": "2.5rem" },
				{ "slug": "xl", "name": "XL", "size": "4rem" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--sand)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0",
				"right": "1rem",
				"bottom": "0",
				"left": "1rem"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.15"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.3"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontWeight": "500"
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--steel)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"button": {
				"color": {
					"text": "var(--wp--preset--color--ink)",
					"background": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontWeight": "600"
				},
				"border": { "radius": "2px" },
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--white)",
						"background": "var(--wp--preset--color--primary)"
					}
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--fog)" }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--accent)", "width": "3px" } },
				"typography": { "fontStyle": "italic" }
			}
		}
	}
}
