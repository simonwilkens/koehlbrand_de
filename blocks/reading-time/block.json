	"keywords": [ "lesezeit", "lesedauer", "minuten", "meta" ],
	"usesContext": [ "postId" ],
	"supports": {
		"html": false,
		"align": false,
		"color": { "text": true, "background": false },
		"spacing": { "margin": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "koehlbrand-reading-time-editor"
}
